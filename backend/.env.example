# Weather to Discord Integration - Environment Variables

# OpenWeatherMap API Configuration
# Obtenez votre clé API sur https://openweathermap.org/api
OPENWEATHERMAP_API_KEY=your_openweathermap_api_key_here

# Optionnel : Discord Webhook par défaut 
# Vous pouvez aussi configurer le webhook directement dans chaque AREA
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# Configuration existante...
DATABASE_URL=postgresql://user:password@localhost:5432/area_db
JWT_SECRET=your-jwt-secret-key
JWT_REFRESH_SECRET=your-jwt-refresh-secret-key

# Autres services OAuth2...
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
